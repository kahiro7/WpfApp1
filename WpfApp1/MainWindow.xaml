<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Grid.ColumnSpan="4" Name="TB_Display" Text="0"
         FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Stretch"
         Margin="10" IsReadOnly="True" TextAlignment="Right" />

        <!-- Ligne 1 : 7 8 9 / -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click" />
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click" />
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Div" Content="/" Click="BTN_Div_Click" />

        <!-- Ligne 2 : 4 5 6 * -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click" />
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click" />
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click" />
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Mult" Content="*" Click="BTN_Mult_Click"/>

        <!-- Ligne 3 : 1 2 3 - -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click" />
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click" />
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Sub" Content="-" Click="BTN_Sub_Click" />

        <!-- Ligne 4 : 0 . = + -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click" />
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_Dot" Content="." Click="BTN_Dot_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_Equal" Content="=" Click="BTN_Equal_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_Add" Content="+" Click="BTN_Add_Click"/>
    </Grid>
</Window>
